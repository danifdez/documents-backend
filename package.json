{
  "name": "documents-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node node_modules/typescript-native/bin/tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:cov:full": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest-coverage.cjs --runInBand --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "contracts:check": "node scripts/sync-execution-contracts.mjs",
    "contracts:check:models": "node scripts/sync-execution-contracts.mjs ../models",
    "contracts:check:all": "node scripts/sync-execution-contracts.mjs ../models ../../ia-browser ai-train:../../ai-train",
    "contracts:sync:models": "node scripts/sync-execution-contracts.mjs --write ../models",
    "contracts:sync:all": "node scripts/sync-execution-contracts.mjs --write ../models ../../ia-browser ai-train:../../ai-train",
    "harness:hardening:audit": "node scripts/audit-harness-boundaries.mjs",
    "typeorm": "typeorm-ts-node-commonjs -d ./typeorm.config.ts",
    "migration:generate": "npm run typeorm migration:generate ./migrations/Init",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "seed:admin": "ts-node src/auth/seed-admin.ts"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.2",
    "@nestjs/common": "12.6.3",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.3",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/passport": "12.0.2",
    "@nestjs/platform-express": "12.6.3",
    "@nestjs/platform-socket.io": "12.6.3",
    "@nestjs/schedule": "12.0.4",
    "@nestjs/throttler": "6.8.0",
    "@nestjs/typeorm": "12.0.3",
    "@nestjs/websockets": "12.6.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@turbodocx/html-to-docx": "1.23.3",
    "@types/fs-extra": "^11.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "archiver": "8.0.0",
    "axios": "1.21.1",
    "bcrypt": "^6.0.0",
    "cheerio": "1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "0.15.1",
    "csv-parse": "7.0.3",
    "fs-extra": "11.4.1",
    "helmet": "8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.23.1",
    "puppeteer": "25.19.0",
    "reflect-metadata": "^0.2.0",
    "rrule": "^2.8.1",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "typeorm": "1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.17",
    "@nestjs/testing": "12.6.3",
    "@types/archiver": "8.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.7",
    "@types/passport-jwt": "4.0.2",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "10.16.0",
    "eslint-config-prettier": "10.1.9",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-native": "npm:typescript@7.0.2"
  },
  "overrides": {
    "brace-expansion@1": "1.1.22",
    "brace-expansion@2": "2.1.8",
    "brace-expansion@5": "5.1.0",
    "engine.io": "6.6.13",
    "fast-uri": "3.1.9",
    "handlebars": "4.7.10",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "multer": "2.5.0",
    "nanoid": "3.3.20",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "undici": "7.30.2",
    "image-size": "2.0.4",
    "glob@>=9": "14.0.6",
    "minimatch@>=7": "11.0.9"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/test/unit"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "isolatedModules": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
