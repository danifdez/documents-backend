# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=documents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=50mb

# File Storage
DOCUMENTS_STORAGE_DIR=../documents
# Where archived resource files are moved. Can point to a slower/cheaper mount.
# Defaults to <DOCUMENTS_STORAGE_DIR>/../documents-archive when unset.
DOCUMENTS_ARCHIVE_DIR=../documents-archive

# Large execution artifact bodies are stored outside PostgreSQL in this directory.
# Defaults to <DOCUMENTS_STORAGE_DIR>/../execution-artifacts when unset.
EXECUTION_ARTIFACT_STORAGE_DIR=../execution-artifacts
# Artifact bodies at or below this size remain inline in PostgreSQL. Set 0 to
# store every non-empty body in EXECUTION_ARTIFACT_STORAGE_DIR.
EXECUTION_ARTIFACT_INLINE_MAX_BYTES=65536

# Authentication (set AUTH_ENABLED=true for multi-user mode)
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production

# Shared high-entropy token for required execution event ingestion.
MODELS_ENROLLMENT_TOKEN=

# Authoritative operation budget for top-level chat loops.
PROGRESS_CHAT_MAX_NORMAL_INFERENCES=3
PROGRESS_CHAT_NORMAL_INFERENCE_SOFT_LIMIT=2
PROGRESS_CHAT_MAX_OUTPUT_REPAIRS=1
PROGRESS_CHAT_CLOSING_INFERENCES=1
PROGRESS_CHAT_MAX_TOKENS_PER_INFERENCE=4096
PROGRESS_CHAT_MAX_TOOL_CALLS=6
PROGRESS_CHAT_TOOL_CALL_SOFT_LIMIT=4
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Offline support (set OFFLINE_ENABLED=true to allow clients to cache content)
OFFLINE_ENABLED=false
OFFLINE_FILE_SIZE_LIMIT=10485760

# Feature Flags (set to false to disable a feature)
FEATURE_CANVAS=true
FEATURE_DATASETS=true
FEATURE_TIMELINES=true
FEATURE_KNOWLEDGE_BASE=true
FEATURE_BIBLIOGRAPHY=true
FEATURE_RELATIONSHIPS=true
FEATURE_BROWSER_FEDERATION=false

# Data Sources (encryption key for API credentials stored in database)
DATASOURCE_ENCRYPTION_KEY=change-me-in-production-32-chars
